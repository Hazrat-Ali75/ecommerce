# ==========================================
# Database Configuration (Neon PostgreSQL)
# ==========================================
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ==========================================
# Application Configuration
# ==========================================
PORT=5000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:5000"

# ==========================================
# JWT Secret & Expirations
# ==========================================
JWT_ACCESS_SECRET="super-secret-jwt-access-token-key-change-in-prod-min32chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="super-secret-jwt-refresh-token-key-change-in-prod-min32chars"
JWT_REFRESH_EXPIRES_IN="7d"
JWT_RESET_SECRET="super-secret-jwt-reset-token-key-change-in-prod-min32chars"
JWT_RESET_EXPIRES_IN="1h"

# ==========================================
# Cloudinary (Product & Banner Assets)
# ==========================================
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# ==========================================
# Stripe (Instant Card Payments)
# ==========================================
STRIPE_SECRET_KEY="sk_test_sample"
STRIPE_WEBHOOK_SECRET="whsec_sample"

# ==========================================
# Resend (Transactional Emails)
# ==========================================
RESEND_API_KEY="re_sample_key"
EMAIL_FROM="BanglaShop <orders@yourdomain.com>"

# ==========================================
# Next.js Public Client Variables
# ==========================================
NEXT_PUBLIC_API_URL="http://localhost:5000/api"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_sample"
